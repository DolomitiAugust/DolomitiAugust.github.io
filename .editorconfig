root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Match .gitattributes: these reviewed animation files stay CRLF.
[src/app.js]
end_of_line = crlf

[src/style.css]
end_of_line = crlf

# Markdown uses trailing double spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false

# Data files use two-space indentation.
[*.{json,yml,yaml}]
indent_size = 2
